{
  "name": "@clidey/dory",
  "private": false,
  "version": "1.11.0",
  "type": "module",
  "description": "A CLI tool for building and previewing documentation sites",
  "keywords": [
    "cli",
    "documentation",
    "build",
    "preview",
    "static-site"
  ],
  "bin": {
    "dory": "./bin/dist/dory.js"
  },
  "files": [
    "bin/dist",
    "dist/runtime",
    "bin/chat-server.ts",
    "bin/styles.ts",
    "bin/embedded-css.ts",
    "docs",
    "!docs/dist",
    "!docs/dist-ssr",
    "src",
    "scripts",
    "index.html",
    "vite.config.ts",
    "vite.config.ssr.ts",
    "vite.config.embed-loader.ts",
    "vite.config.embed-widget.ts"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/clidey/dory.git"
  },
  "author": "Clidey",
  "license": "MIT",
  "homepage": "https://github.com/clidey/dory",
  "bugs": {
    "url": "https://github.com/clidey/dory/issues"
  },
  "scripts": {
    "dev": "vite",
    "build": "pnpm run build:cli && tsc -b && pnpm run build:docs && pnpm run build:runtime",
    "build:runtime": "vite build -c vite.config.runtime.ts && cp src/embedded-runtime/runtime.html dist/runtime/dory-runtime.html",
    "build:server": "vite build -c vite.config.server.ts",
    "build:cli": "tsc -p tsconfig.bin.json",
    "build:docs": "vite build && vite build --config vite.config.ssr.ts && node scripts/render-routes.mjs",
    "build:embed": "npm run build:embed:loader && npm run build:embed:widget",
    "build:embed:loader": "vite build -c vite.config.embed-loader.ts",
    "build:embed:widget": "vite build -c vite.config.embed-widget.ts",
    "preview": "vite preview",
    "test": "node scripts/check-trigger-children.mjs src && vitest run",
    "test:error-recovery": "node scripts/verify-error-recovery.mjs",
    "test:runtime-parity": "pnpm run build && node scripts/verify-runtime-parity.mjs",
    "lint:triggers": "node scripts/check-trigger-children.mjs src",
    "publish": "npm run build && npm publish --access public --no-git-checks",
    "prepublishOnly": "echo 'Skipping prepublishOnly - build handled by publish script'"
  },
  "dependencies": {
    "@algolia/autocomplete-core": "1.19.12",
    "@clidey/ux": "1.6.4",
    "@headlessui/react": "2.2.10",
    "@mdx-js/mdx": "3.1.1",
    "@mdx-js/preact": "3.1.1",
    "@mdx-js/rollup": "3.1.1",
    "@modelcontextprotocol/node": "2.1.2",
    "@modelcontextprotocol/server": "2.4.0",
    "@preact/preset-vite": "2.10.6",
    "@resvg/resvg-js": "2.6.2",
    "@tailwindcss/vite": "4.3.4",
    "classnames": "2.5.1",
    "flexsearch": "0.8.212",
    "gray-matter": "4.0.3",
    "katex": "0.19.1",
    "mermaid": "12.3.0",
    "motion": "14.9.0",
    "playwright-core": "1.64.1",
    "postcss": "8.5.32",
    "postcss-value-parser": "4.2.0",
    "preact": "11.1.1",
    "preact-render-to-string": "6.8.2",
    "prism-react-renderer": "2.4.1",
    "react-highlight-words": "1.0.0",
    "rehype-slug": "6.0.0",
    "remark-gfm": "4.0.1",
    "sass-embedded": "1.107.1",
    "sirv": "3.0.2",
    "tailwindcss": "4.3.4",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "unist-util-visit": "5.2.0",
    "vite": "8.3.5",
    "wouter-preact": "3.13.0",
    "zod": "4.6.7"
  },
  "packageManager": "pnpm@12.13.0+sha512.1e55719bf26e809dce5c5084fdebaa64efb3da9038ae5d68a9f8a68311f1a45841c8c3b76a37298c3b66f6bcc80409a9b7f33c78a7168a3e90fb65a5d8235ae4",
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/react-highlight-words": "0.20.1",
    "@typescript/typescript6": "6.0.2",
    "vitest": "5.1.0"
  }
}
