# Server-side documentation chat. Copy to an uncommitted .env file or set in your host's secret manager.
DORY_CHAT_API_KEY=
DORY_CHAT_MODEL=gpt-6-luna
# An existing OPENAI_API_KEY is accepted instead of DORY_CHAT_API_KEY.
# DORY_CHAT_BASE_URL=https://api.openai.com/v1
# DORY_CHAT_PER_MINUTE=3
# DORY_CHAT_PER_IP_DAY=20
# DORY_CHAT_GLOBAL_DAY=100
# DORY_CHAT_MAX_CONCURRENT=2
# DORY_CHAT_MAX_OUTPUT_TOKENS=500

