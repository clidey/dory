{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^apply_patch$|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/.agents/hooks/repo-hooks.py\"",
            "timeout": 30,
            "statusMessage": "Checking edit rules"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^apply_patch$|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/.agents/hooks/repo-hooks.py\"",
            "timeout": 300,
            "statusMessage": "Running repository hooks"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/.agents/hooks/repo-hooks.py\"",
            "timeout": 600,
            "statusMessage": "Running repository checks"
          }
        ]
      }
    ]
  }
}
