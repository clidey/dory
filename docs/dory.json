{
  "name": "Dory",
  "url": "https://dory.clidey.com",
  "description": "Static documentation site generator for modern teams. Build beautiful docs from MDX files.",
  "seo": {
    "titleTemplate": "%s \u2014 Dory"
  },
  "favicon": "./favicon.svg",
  "colors": {
    "primary": "#4787F3",
    "light": "#2C6BD4",
    "dark": "#4787F3",
    "background": "#0E2240",
    "surface": "#162B4A",
    "surfaceElevated": "#1D3151",
    "foreground": "#FAF5EC",
    "mutedForeground": "#86909F",
    "border": "rgb(250 245 236 / 14%)"
  },
  "theme": {
    "mode": "dark"
  },
  "fonts": {
    "family": "Hanken Grotesk",
    "stylesheet": "https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400..800&family=Hanken+Grotesk:ital,wght@0,400..700;1,400..700&family=JetBrains+Mono:wght@400;500&display=swap",
    "heading": {
      "family": "Bricolage Grotesque"
    },
    "mono": {
      "family": "JetBrains Mono"
    }
  },
  "logo": {
    "light": "./logo/logo.svg",
    "dark": "./logo/logo.svg"
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Documentation",
        "groups": [
          {
            "group": "Getting Started",
            "pages": [
              "introduction",
              "getting-started/installation",
              "getting-started/quick-start",
              "getting-started/configuration"
            ]
          },
          {
            "group": "Components",
            "pages": [
              "components/overview",
              "components/typography",
              "components/code-blocks",
              "components/callouts",
              "components/cards",
              "components/accordion",
              "components/expandable",
              "components/steps",
              "components/tables",
              "components/lists",
              "components/icons",
              "components/tags",
              "components/images",
              "components/layout",
              "components/source",
              "components/mermaid",
              "components/latex"
            ]
          },
          {
            "group": "Interactive Playgrounds",
            "pages": [
              "playgrounds/api-playground",
              "playgrounds/websocket-playground"
            ]
          },
          {
            "group": "Configuration",
            "pages": [
              "configuration/dory-json",
              "configuration/navigation",
              "configuration/theming",
              "configuration/fonts",
              "configuration/analytics",
              "configuration/embed"
            ]
          }
        ]
      }
    ]
  }
}
