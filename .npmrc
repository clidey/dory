# Registry settings for pnpm/npm. pnpm reads only registry and auth settings
# from this file; its other settings are in pnpm-workspace.yaml.

# Enforce official registry (prevent typosquatting via alternate registries)
registry=https://registry.npmjs.org/

# Strict SSL validation
strict-ssl=true

# npm/npx: delay installation of packages published less than 7 days ago
min-release-age=7

# npm/npx: never run lifecycle scripts. Also keeps `npm publish` from running
# the package.json "publish" script, which would publish a second time.
ignore-scripts=true
